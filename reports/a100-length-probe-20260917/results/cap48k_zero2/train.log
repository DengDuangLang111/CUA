Let me write the script carefully.

The mbox format: messages are separated by lines beginning with "From " (specifically "From - " here). A message block includes its "From " line. So when I extract a message, I include its "From - " line through the lines before the next "From - " line (or end of file).

Let me write the Python:

```python
import re, os

base = os.path.expanduser("~/.thunderbird/audit.default/Mail/Local Folders")
ref_path = os.path.join(base, "Referrals")
docs = os.path.expanduser("~/Documents")

with open(ref_path, "rb") as f:
    data = f.read()

# Decode
text = data.decode("utf-8")
lines = text.splitlines(keepends=True)

# Split into messages by "From " at line start
messages = []
current = []
for line in lines:
    if line.startswith("From "):
        if current:
            messages.append("".join(current))
        current = [line]
    else:
        current.append(line)
if current:
    messages.append("".join(current))

# For each message, detect specialty
specialty_files = {}  # specialty -> list of message blocks
no_specialty = []

for msg in messages:
    # find specialty
    m = re.search(r"Specialty:\s*([A-Z][A-Za-z]+)", msg)
    if m:
        spec = m.group(1)
        specialty_files.setdefault(spec, []).append(msg)
    else:
        no_specialty.append(msg)

# Write specialty files
for spec, msgs in specialty_files.items():
    path = os.path.join(base, spec)
    with open(path, "wb") as f:
        for msg in msgs:
            # ensure message ends with newline
            if not msg.endswith("\n"):
                msg += "\n"
            f.write(msg.encode("utf-8"))

# Empty the Referrals mbox
with open(ref_path, "wb") as f:
    f.write(b"")

# Write no-specialty text file
os.makedirs(docs, exist_ok=True)
txt_path = os.path.join(docs, "no_specialty_referrals.txt")
with open(txt_path, "w") as f:
    f.write("Referrals with no specialty\n")
    f.write("===========================\n\n")
    for i, msg in enumerate(no_specialty, 1):
        subj = re.search(r"^Subject:\s*(.*)$", msg, re.M)
        mid = re.search(r"^Message-ID:\s*(.*)$", msg, re.M)
        # body
        body = msg.split("\n\n", 1)[1] if "\n\n" in msg else ""
        body = body.strip()
        f.write(f"{i}. Subject: {subj.group(1).strip() if subj else 'N/A'}\n")
        f.write(f"   Message-ID: {mid.group(1).strip() if mid else 'N/A'}\n")
        f.write(f"   {body}\n\n")

print("Specialty files:", {k: len(v) for k, v in specialty_files.items()})
print("No specialty count:", len(no_specialty))
```

