        current = [line]
    else:
        current.append(line)
if current:
    messages.append("".join(current))

print("Total messages:", len(messages))

specialty_files = {}
no_specialty = []

for msg in messages:
    m = re.search(r"Specialty:\s*([A-Z][A-Za-z]+)", msg)
    mid = re.search(r"^Message-ID:\s*(\S+)", msg, re.M)
    label = mid.group(1) if mid else "?"
    if m:
        specialty_files.setdefault(m.group(1), []).append(msg)
        print("  ", label, "->", m.group(1))
    else:
        no_specialty.append(msg)
        print("  ", label, "-> NO SPECIALTY")

for spec, msgs in specialty_files.items():
    with open(os.path.join(base, spec), "w", encoding="utf-8") as f:
        for msg in msgs:
            if not msg.endswith("\n"):
                msg += "\n"
            f.write(msg)
    print("Wrote folder:", spec, "count:", len(msgs))

with open(ref_path, "w", encoding="utf-8") as f:
    f.write("")
print("Emptied Referrals")

os.makedirs(docs, exist_ok=True)
