```python
import re, os

base = os.path.expanduser("~/.thunderbird/audit.default/Mail/Local Folders")
ref_path = os.path.join(base, "Referrals")
docs = os.path.expanduser("~/Documents")

with open(ref_path, "r", encoding="utf-8") as f:
    text = f.read()

lines = text.splitlines(keepends=True)

# Split into messages by lines starting with "From "
messages = []
current = []
for line in lines:
    if line.startswith("From "):
        if current:
            messages.append("".join(current))
        current = [line]
    else:
        current.append(line)
if current:
    messages.append("".join(current))

print(f"Total messages: {len(messages)}")

specialty_files = {}
no_specialty = []

for msg in messages:
    m = re.search(r"Specialty:\s*([A-Z][A-Za-z]+)", msg)
    mid = re.search(r"^Message-ID:\s*(\S+)", msg, re.M)
    if m:
        spec = m.group(1)
        specialty_files.setdefault(spec, []).append(msg)
    else:
        no_specialty.append(msg)
    print(f"  {mid.group(1) if mid else '?'} -> {m.group(1) if m else 'NO SPECIALTY'}")

# Write specialty mbox files
for spec, msgs in specialty_files.items():
    path = os.path.join(base, spec)
    with open(path, "w", encoding="utf-8") as f:
        for msg in msgs:
            if not msg.endswith("\n"):
                msg += "\n"
            f.write(msg)
    print(f"Wrote {spec}: {len(msgs)} message(s)")

# Empty the Referrals mbox
with open(ref_path, "w", encoding="utf-8") as f:
    f.write("")

print("Emptied Referrals")

# Write no-specialty text file
os.makedirs(docs, exist_ok=True)
txt_path = os.path.join(docs, "no_specialty_referrals.txt")
with open(txt_path, "w", encoding="utf-8") as f:
    f.write("Referrals with no specialty\n")
    f.write("===========================\n")
    f.write("Source: Local Folders > Referrals (cleared for audit)\n\n")
    for i, msg in enumerate(no_specialty, 1):
        subj = re.search(r"^Subject:\s*(.*)$", msg, re.M)
        mid = re.search(r"^Message-ID:\s*(\S+)", msg, re.M)
        parts = msg.split("\n\n", 1)
        body = parts[1].strip() if len(parts) > 1 else ""
        f.write(f"{i}. {subj.group(1).strip() if subj else 'No subject'}\n")
        f.write(f"   Message-ID: {mid.group(1) if mid else 'N/A'}\n")
        f.write(f"   {body}\n\n")

print(f"Wrote {txt_path}")
```

