{
  "policy_version": "webstar-filter-v1",
  "status": "calibration-pending",
  "paper": "https://aclanthology.org/2026.acl-long.21/",
  "reference_repository": "https://github.com/yifei-he/WebSTAR",
  "reference_commit": "d5c2a34cb7ff193a85c144fdd91f48a0e716da86",
  "reference_license_note": "No LICENSE, COPYING, or NOTICE file was present at the pinned commit; this implementation is an attributed clean-room adaptation, not a verbatim vendor copy.",
  "grader_model": "o4-mini",
  "max_annotated_screenshots": 3,
  "previous_action_history": "full",
  "action_crop_size": 200,
  "grading_stages": [
    "screenshot_analysis",
    "proposed_action_review",
    "alternative_analysis",
    "evaluation"
  ],
  "alternative_count": 3,
  "score_min": 0,
  "score_max": 10,
  "keep_condition": "score > 5",
  "thought_augmentation": false,
  "judge_original_teacher_think": false,
  "judge_post_action_screenshot": false,
  "preserve_original_target": true,
  "preserve_rejected_steps_in_later_context": true,
  "terminal_policy": "explicit_done_must_be_kept_or_reviewed",
  "trajectory_normalization": false,
  "exposure_matching": false
}
